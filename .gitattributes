# Normalize all text files to LF in the repository.
* text=auto

# Kotlin / Gradle build sources
*.kt text eol=lf
*.kts text eol=lf
*.gradle text eol=lf
*.toml text eol=lf
*.pro text eol=lf

# Markup / config / docs
*.xml text eol=lf
*.properties text eol=lf
*.md text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf
*.editorconfig text eol=lf
*.txt text eol=lf
*.sh text eol=lf

# Windows batch scripts stay CRLF for cross-platform compatibility
*.bat text eol=crlf

# Executable scripts with no extension
gradlew text eol=lf

# Binary files (never normalize)
*.jar binary
*.webp binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
